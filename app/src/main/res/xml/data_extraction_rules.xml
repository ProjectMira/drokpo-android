<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ counterpart of android:allowBackup="false" (which only covers
     cloud backup on 12+): nothing goes to cloud backup or device-to-device
     transfer either. The Firebase Auth session, the FCM installation/token
     and the per-account blocked list must not be cloned onto another device;
     the user signs in again there. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
