<?xml version="1.0" encoding="utf-8"?>
<!-- Brand launcher icon: flat #FF0000 ground, blue #1877F2 handshake with a
     thin white halo (same art as the iOS AppIcon). Layers are generated by
     ci/make_brand_assets.py; the monochrome layer drives Android 13+ themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
