<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only: the screen catalog (ARCHITECTURE.md "Debug catalog", CONTRACT.md §E).
     Launch with adb: am start -n app.drokpo.android/.catalog.CatalogActivity, optionally with the
     string extra "entry" (an entry id) and the boolean extra "dark" (see CatalogActivity.kt). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name=".catalog.CatalogActivity"
            android:exported="true"
            android:label="@string/catalog_label"
            android:theme="@style/Theme.Drokpo"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density|fontScale|fontWeightAdjustment|grammaticalGender|locale|layoutDirection|mcc|mnc|touchscreen|navigation|colorMode" />
    </application>
</manifest>
